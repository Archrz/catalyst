                "conflict.background": "#2a2210ff",
                "conflict.border": "#ffb454ff",
                "error": "#f07178ff",
                "error.background": "#2a1010ff",
                "error.border": "#f07178ff",
                "warning": "#ffb454ff",
                "warning.background": "#2a2210ff",
                "warning.border": "#ffb454ff",
                "info": "#39bae6ff",
                "info.background": "#0d1f2aff",
                "info.border": "#39bae6ff",
                "hint": "#39bae6ff",
                "hint.background": "#0d1f2aff",
                "hint.border": "#39bae6ff",
                "success": "#a6e3a1ff",
                "success.background": "#1a2410ff",
                "success.border": "#a6e3a1ff",
                "predictive": "#686868ff",
                "hidden": "#686868ff",
                "ignored": "#686868ff",
                "renamed": "#39bae6ff",
                "unreachable": "#686868ff",

                "players": [
                    {
                        "cursor": "#ffb454ff",
                        "background": "#ffb454ff",
                        "selection": "#2d3640ff"
                    }
                ],

                "syntax": {
                    "comment": { "color": "#686868ff" },
                    "keyword": { "color": "#ffb454ff" },
                    "operator": { "color": "#8e959eff" },
                    "punctuation": { "color": "#8e959eff" },
                    "punctuation.special": { "color": "#ffb454ff" },
                    "punctuation.list_marker": { "color": "#ffb454ff" },
                    "function": { "color": "#39bae6ff" },
                    "constructor": { "color": "#39bae6ff" },
                    "type": { "color": "#e6b673ff" },
                    "string": { "color": "#a6e3a1ff" },
                    "string.escape": { "color": "#39bae6ff" },
                    "string.regex": { "color": "#39bae6ff" },
                    "string.special": { "color": "#39bae6ff" },
                    "string.special.symbol": { "color": "#a6e3a1ff" },
                    "number": { "color": "#ffb454ff" },
                    "boolean": { "color": "#ffb454ff" },
                    "constant": { "color": "#ffb454ff" },
                    "variable": { "color": "#e6e1cfff" },
                    "variable.special": { "color": "#f07178ff" },
                    "variable.parameter": { "color": "#8e959eff" },
                    "property": { "color": "#a6e3a1ff" },
                    "attribute": { "color": "#39bae6ff" },
                    "tag": { "color": "#f07178ff" },
                    "label": { "color": "#f07178ff" },
                    "namespace": { "color": "#e6b673ff" },
                    "preproc": { "color": "#ffb454ff" },
                    "embedded": { "color": "#e6e1cfff" },
                    "emphasis": { "color": "#39bae6ff" },
                    "emphasis.strong": {
                        "color": "#39bae6ff",
                        "font_weight": 700
                    },
                    "title": { "color": "#e6e1cfff", "font_weight": 700 },
                    "link_text": { "color": "#39bae6ff" },
                    "link_uri": { "color": "#39bae6ff" },
                    "text.literal": { "color": "#a6e3a1ff" },
                    "hint": { "color": "#39bae6ff" },
                    "predictive": { "color": "#686868ff" },
                    "primary": { "color": "#e6e1cfff" }
