                "border.focused": "#ffb454ff",
                "border.selected": "#2d3640ff",
                "border.transparent": "#00000000",
                "border.disabled": "#1a1a1aff",

                "element.background": "#0d0d0dff",
                "element.hover": "#1a1a1aff",
                "element.active": "#2d3640ff",
                "element.selected": "#2d3640ff",
                "element.disabled": "#0d0d0dff",
                "ghost_element.background": "#00000000",
                "ghost_element.hover": "#1a1a1aff",
                "ghost_element.active": "#2d3640ff",
                "ghost_element.selected": "#2d3640ff",
                "ghost_element.disabled": "#00000000",
                "drop_target.background": "#2d364080",

                "text": "#e6e1cfff",
                "text.muted": "#8e959eff",
                "text.placeholder": "#686868ff",
