                "text.accent": "#ffb454ff",
                "icon": "#e6e1cfff",
                "icon.muted": "#8e959eff",
                "icon.disabled": "#686868ff",
                "icon.placeholder": "#686868ff",
                "icon.accent": "#ffb454ff",

                "status_bar.background": "#000000ff",
                "title_bar.background": "#000000ff",
                "title_bar.inactive_background": "#000000ff",
                "toolbar.background": "#0d0d0dff",
                "tab_bar.background": "#000000ff",
                "tab.inactive_background": "#000000ff",
                "tab.active_background": "#0d0d0dff",

                "search.match_background": "#ffb45433",
                "link_text.hover": "#39bae6ff",

