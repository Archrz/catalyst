{
    "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
    "name": "Catalyst",
    "author": "archrz",
    "themes": [
        {
            "name": "Catalyst",
            "appearance": "dark",
            "style": {
                "background": "#0d0d0dff",
                "surface.background": "#000000ff",
                "elevated_surface.background": "#0d0d0dff",
                "panel.background": "#000000ff",
                "panel.focused_border": "#ffb454ff",
                "pane.focused_border": "#ffb454ff",
                "pane_group.border": "#2d3640ff",

                "border": "#2d3640ff",
